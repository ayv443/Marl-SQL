# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ============ Jupyter ============
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============ Data: never commit ============
# `data/*` rather than `data/`: git cannot re-include anything under an excluded
# directory, and the .gitkeep files have to survive so a fresh clone has somewhere
# to download Spider into.
data/*
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

*.sqlite
*.sqlite3
*.db
*.csv
*.tsv
*.jsonl
*.zip
*.tar.gz

# ============ Model weights and checkpoints ============
checkpoints/
adapters/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# ============ Experiment output ============
# Same reason as data/ above: `results/*` so the per-run artefacts can be re-included.
# Spec invariant 7 -- "an unlogged run did not happen" -- requires the full resolved
# config of every run on disk, and spec 14 says the CSV is what survives. Both have
# to be committed; the checkpoints under the same directory must not be, and are
# already covered by the section above.
results/*
runs/
wandb/
lightning_logs/
*.log

!results/.gitkeep
!results/*/
!results/*/metrics.csv
!results/*/config.yaml
!results/*/eval_*.json
!results/summary/
!results/summary/*.csv

# ============ Caches ============
.cache/
hf_cache/
.ray/
ray_results/

# ============ SageMaker / EBS ============
.sagemaker/
lost+found/

# ============ Secrets ============
.env
.env.*
*.pem
*.key
aws_credentials*
.aws/

# ============ OS and editor ============
.DS_Store
Thumbs.db
.vscode/
.idea/

# ============ Exceptions: small summary tables DO get committed ============
!configs/*.yaml

# Per-person `pip freeze` output, for diagnosing environment drift between the two
# SageMaker spaces. Lives in environment/ rather than env/ because env/ is ignored
# above as a virtualenv directory.
!environment/
!environment/*.txt
